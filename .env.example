# ClubOps environment variables — PLACEHOLDERS ONLY
# Copy to .env.local for local development (never commit .env.local)
#
# PUBLIC DEMO (Vercel production): leave Supabase vars EMPTY or unset.
# CLUBOPS_PROVIDER_MODE must stay "demo" on the public demo URL.

# --- Provider mode (required) ---
# Public demo: demo (default). Live: only on private deployment after security review.
CLUBOPS_PROVIDER_MODE=demo

# --- Supabase (PRIVATE LIVE DEPLOYMENT ONLY — not used on public demo) ---
# Do not set these on the public Vercel demo project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — NEVER expose to client, NEVER commit real values.
# Used only for trusted server-side tasks in private live deployment.
SUPABASE_SERVICE_ROLE_KEY=
