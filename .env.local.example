# Local development — copy to .env.local (gitignored)
#
# For public demo behaviour locally: leave Supabase vars empty, CLUBOPS_PROVIDER_MODE=demo
# For future private live dev: set Supabase vars from a DEV Supabase project only — never production keys in shared machines

CLUBOPS_PROVIDER_MODE=demo

# Optional — only when testing private live scaffold (not required for demo)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
